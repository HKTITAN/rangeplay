@@ -714,13 +714,29 @@ char *MSG_ReadString (void)
 	return string;
 }
 
+// PROTOCOL_RMQ demos can use wider coordinates and angles: set by the client from svc_serverinfo
+int msg_protocolflags;
+
 float MSG_ReadCoord (void)
 {
+	if (msg_protocolflags & PRFL_FLOATCOORD)
+		return MSG_ReadFloat ();
+	if (msg_protocolflags & PRFL_INT32COORD)
+		return MSG_ReadLong () * (1.0/16);
+	if (msg_protocolflags & PRFL_24BITCOORD)
+	{
+		int whole = MSG_ReadShort ();
+		return whole + MSG_ReadByte () * (1.0/255);
+	}
 	return MSG_ReadShort() * (1.0/8);
 }
 
 float MSG_ReadAngle (void)
 {
+	if (msg_protocolflags & PRFL_FLOATANGLE)
+		return MSG_ReadFloat ();
+	if (msg_protocolflags & PRFL_SHORTANGLE)
+		return MSG_ReadShort () * (360.0/65536);
 	return MSG_ReadChar() * (360.0/256);
 }
 
